-- Background Automation Loop
task.spawn(function()
    local lastHourCoin = 0
    local lastHourCorpse = 0
    
    local function isSacrificeAllowed(name)
        if string.find(name, "Volcanic Bear Trap") then return false end
        if string.find(name, "Mammoth Tusk") then return false end
        if string.find(name, "Cultist King") then return false end
        if string.find(name, "Scorpion Shell") then return false end
        return true
    end
    
    local function dumpCorpsesToVoid()
        local corpsesToThrow = {}
        
        local chars = workspace:FindFirstChild("Characters")
        if chars then
            for _, c in ipairs(chars:GetChildren()) do
                if c:IsA("Model") and c.Name ~= _Players.LocalPlayer.Name then
                    if isEnemy(c.Name) and c:GetAttribute("Interaction") ~= nil and not c:GetAttribute("Burning") and isSacrificeAllowed(c.Name) then
                        table.insert(corpsesToThrow, c)
                    end
                end
            end
        end

        local itemsFolder = (workspace:FindFirstChild("Items") or workspace:FindFirstChild("items"))
        if itemsFolder then
            for _, c in ipairs(itemsFolder:GetChildren()) do
                if c:IsA("Model") and isEnemy(c.Name) and c:GetAttribute("Interaction") ~= nil and not c:GetAttribute("Burning") and isSacrificeAllowed(c.Name) then
                    table.insert(corpsesToThrow, c)
                end
            end
        end

        if #corpsesToThrow > 0 then
            WindUI:Notify({Title = "System (Lag Clear)", Content = "Dumping " .. #corpsesToThrow .. " Corpses to the Void to reduce lag...", Duration = 5})
            
            local oldAntiVoid = _G.AntiVoidItemsEnabled
            _G.AntiVoidItemsEnabled = false
            
            local destPos = Vector3.new(0, -100, 0)
            for _, c in ipairs(corpsesToThrow) do
                task.spawn(function() dragItemSmooth(c, destPos) end)
                task.wait(0.05)
            end
            
            task.wait(2)
            _G.AntiVoidItemsEnabled = oldAntiVoid
        end
    end

    while true do
        local runTime = os.time() - scriptStartTime
        local currentHour = math.floor(runTime / 3600)
        
        if _G.AutoCollectCoinStacksEnabled and currentHour > lastHourCoin then
            lastHourCoin = currentHour
            task.spawn(_G.CollectAllCoinStacks)
        end
        
        if _G.AutoBringCorpseToVoidEnabled and currentHour > lastHourCorpse and currentHour % 2 == 0 then
            lastHourCorpse = currentHour
            task.spawn(dumpCorpsesToVoid)
        end
        
        task.wait(30)
    end
end)

