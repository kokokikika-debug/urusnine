local function GetPlayerDisplayListAndMap()
    local list = {}
    local map = {}
    local displayCounts = {}
    for _, p in ipairs(_Players:GetPlayers()) do
        if p ~= _LocalPlayer then
            displayCounts[p.DisplayName] = (displayCounts[p.DisplayName] or 0) + 1
        end
    end
    for _, p in ipairs(_Players:GetPlayers()) do
        if p ~= _LocalPlayer then
            local nameToUse = p.DisplayName
            if displayCounts[p.DisplayName] > 1 then
                nameToUse = string.format("%s (@%s)", p.DisplayName, p.Name)
            end
            table.insert(list, nameToUse)
            map[nameToUse] = p.Name
        end
    end
    table.sort(list)
    return list, map
end

