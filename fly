getgenv().KixHubCleanup = function()
    -- 0. Save current state
    getgenv().KixHubSavedState = {
        WalkSpeed = WalkSpeedEnabled,
        TargetWalkSpeed = TargetWalkSpeed,
        InfJump = InfiniteJumpEnabled,
        InstantInteract = InstantInteractEnabled,
        NoFog = NoFogEnabled,
        KillAura = killAuraEnabled,
        ChopAura = chopAuraEnabled,
        AutoCamp = autoUpgCamp,
        AutoScrap = autoScrap,
        AutoCook = autoCook,
        AutoSacrifice = autoSacrifice,
        EspPlayerOn = _G.EspPlayerOn,
        HUDOn = _G.HUDOn
    }

    -- 1. Stop all toggles
    WalkSpeedEnabled = false
    InfiniteJumpEnabled = false
    InstantInteractEnabled = false
    NoFogEnabled = false
    killAuraEnabled = false
    chopAuraEnabled = false
    autoUpgCamp = false
    autoScrap = false
    autoCook = false
    autoSacrifice = false

    -- 2. Disconnect connections
    if walkSpeedConn then walkSpeedConn:Disconnect() end
    if flyConnection then flyConnection:Disconnect() end
    if rsConn then rsConn:Disconnect() end
    if tickConn then task.cancel(tickConn) tickConn = nil end
    if _G.GodModeConn then _G.GodModeConn:Disconnect() end
    if espLoop then espLoop:Disconnect() end
    if hudConn then hudConn:Disconnect() end
    
    for _, bg in pairs(_G.playerBillboards or {}) do if bg then bg:Destroy() end end
    table.clear(_G.playerBillboards or {})
    if hudFps then hudFps:Remove() end
    if hudPing then hudPing:Remove() end

    -- 3. Restore characters
    if humanoid then humanoid.WalkSpeed = 16 end
    _G.GodModeNaN = false
    pcall(function() stopFlying() end)
    pcall(function() restoreFog() end)

    -- 4. Destroy UI safely
    if getgenv().KixHubWindow then
        pcall(function() getgenv().KixHubWindow:Destroy() end)
        getgenv().KixHubWindow = nil
    end
    getgenv().KixHubCleanup = nil
end

