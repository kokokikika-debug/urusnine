end

local function executeBring(categorySelections, forcedDestination)
    if #categorySelections <= 0 then 
        WindUI:Notify({Title="Bring Failed", Content="Please select items first!", Duration=3})
        return 
    end
    
    task.spawn(function()
        local destPos = scrapMachinePos
        local isVoid = false
        local oldAntiVoid = _G.AntiVoidItemsEnabled

        -- Jika forcedDestination diberikan,
        -- gunakan destination tersebut dan abaikan setting global.
        local destination = forcedDestination or bringDestination

        if destination == "Player" then
            local hrp = _LocalPlayer.Character
                and _LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

            if hrp then
                destPos = hrp.Position
            end

        elseif destination == "Scrap Machine" then
            destPos = scrapMachinePos

        elseif destination == "Fire" then
            destPos = campfirePos

        elseif destination == "Void (Trash)" then
            destPos = Vector3.new(0, -100, 0)
            isVoid = true
            _G.AntiVoidItemsEnabled = false
        end
            
            local brought = 0
            local wantsCorpse = table.find(categorySelections, "Corpse") ~= nil
            
            if wantsCorpse then
                local validEntities = {
                    "Mammoth", "Mossy Mammoth"
                }
                local function isEnemy(name)
                    if string.find(name, "Resurrected") then return false end
                    if string.find(name, "Gem") or string.find(name, "Prototype") or string.find(name, "Experiment") or string.find(name, "Hide") or string.find(name, "Meat") or string.find(name, "Fur") or string.find(name, "Pelt") or string.find(name, "Bunny Foot") or string.find(name, "Armour") or string.find(name, "Rifle") or string.find(name, "Laser") or string.find(name, "Cannon") or string.find(name, "Sword") or string.find(name, "Chest") then return false end
                    for _, en in ipairs(validEntities) do
                        if string.find(name, en) then return true end
                    end
                    return false
                end
                
                local chars = _Workspace:FindFirstChild("Characters")
                if chars then
                    for _, c in ipairs(chars:GetChildren()) do
                        if brought >= bringAmount then break end
                        if c:IsA("Model") and c.Name ~= _LocalPlayer.Name then
                            if isEnemy(c.Name) and c:GetAttribute("Interaction") ~= nil and not c:GetAttribute("Burning") then
                                task.spawn(function() dragItemSmooth(c, destPos) end)
                                brought = brought + 1
                                task.wait(0.05)
                            end
                        end
                    end
                end
            end
            
            local itemsFolder = (_Workspace:FindFirstChild("Items") or workspace:FindFirstChild("items"))
            if itemsFolder then
                local stackHeight = 0
                for _, item in ipairs(itemsFolder:GetChildren()) do
                    if brought >= bringAmount then break end
                    
                    if table.find(categorySelections, item.Name) then
                        stackHeight = (stackHeight + 0.5) % 25
                        local angle = brought * math.rad(35)
                        local dropPos = destPos + Vector3.new(math.cos(angle) * 3, stackHeight, math.sin(angle) * 3)
