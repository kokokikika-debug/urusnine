local function getBestAxe()
    -- Jika player sedang memegang axe, gunakan axe tersebut terlebih dahulu.
    local char = _LocalPlayer.Character

    if char then
        local toolHandle = char:FindFirstChild('ToolHandle')

        if toolHandle
            and toolHandle:GetAttribute('WeaponResourceDamage') then

            local originalItem = toolHandle:FindFirstChild('OriginalItem')

            if originalItem
                and originalItem:IsA('ObjectValue')
                and originalItem.Value then

                return originalItem.Value, 'dummy'
            end
        end
    end

    -- Combat automation boleh menggunakan axe dari Inventory.
    local inv = _LocalPlayer:FindFirstChild('Inventory')

    if not inv then
        return nil, nil
    end

    for _, name in ipairs(axePriority) do
        local item = inv:FindFirstChild(name)

        if item then
            return item, toolEquipData[name]
        end
    end

    return nil, nil
end


