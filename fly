                        if not (string.find(name, "Gem") or string.find(name, "Prototype") or string.find(name, "Experiment") or string.find(name, "Hide") or string.find(name, "Meat") or string.find(name, "Fur") or string.find(name, "Pelt") or string.find(name, "Armour") or string.find(name, "Rifle") or string.find(name, "Laser") or string.find(name, "Cannon") or string.find(name, "Sword")) then
