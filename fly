            end
        end)
    end
end)

local hudConn = _RunService.RenderStepped:Connect(function()
    local mySg = game.CoreGui:FindFirstChild("KixHubStatsHUD")
    if mySg then mySg.Enabled = _G.HUDOn end
    if not _G.HUDOn then return end
    
    hudFrames = hudFrames + 1
    local now = os.clock()
    if now - lastHudUpdate >= 1 then
        hudCurrentFps = math.floor(hudFrames / (now - lastHudUpdate))
        hudFrames = 0
        lastHudUpdate = now
        
        if mySg and mySg:FindFirstChild("MainFrame") then
            local mf = mySg.MainFrame
            local lFps = mf:FindFirstChild("FpsLabel")
            local lPing = mf:FindFirstChild("PingLabel")
            local lFire = mf:FindFirstChild("FireLabel")
            local lRaid = mf:FindFirstChild("RaidLabel")
            
            -- Update FPS
            if lFps then
                lFps.Text = string.format('FPS: %d', hudCurrentFps)
                lFps.TextColor3 = hudCurrentFps >= 50 and Color3.fromRGB(0, 255, 0) or (hudCurrentFps >= 30 and Color3.fromRGB(255, 165, 0) or Color3.fromRGB(255, 0, 0))
            end
            
            -- Update Ping
            if lPing then
                local pingVal = 0
                pcall(function() pingVal = math.round(_LocalPlayer:GetNetworkPing() * 1000) end)
                local pingColor = Color3.fromRGB(0, 255, 0)
                if pingVal > 120 then pingColor = Color3.fromRGB(255, 0, 0)
                elseif pingVal > 60 then pingColor = Color3.fromRGB(255, 165, 0) end
                lPing.Text = string.format('Ping: %d ms', pingVal)
                lPing.TextColor3 = pingColor
            end
            
            -- Update Campfire
            if lFire then
                local firePercent = 0
                local mainFire = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Campground") and workspace.Map.Campground:FindFirstChild("MainFire")
                if mainFire then
                    local fill = mainFire:FindFirstChild("Center") and mainFire.Center:FindFirstChild("BillboardGui") and mainFire.Center.BillboardGui:FindFirstChild("Frame") and mainFire.Center.BillboardGui.Frame:FindFirstChild("Background") and mainFire.Center.BillboardGui.Frame.Background:FindFirstChild("Fill")
                    if fill then
                        firePercent = math.clamp(math.floor(fill.Size.X.Scale * 100 + 0.5), 0, 100)
                    end
                end
                lFire.Text = string.format('🔥 Campfire: %d%%', firePercent)
            end
            
            -- Update Stronghold
            if lRaid then
                if _G.FinalGateOpenTime and (os.time() - _G.FinalGateOpenTime < 300) then
                    local openTimeLeft = 300 - (os.time() - _G.FinalGateOpenTime)
                    local omins = math.floor(openTimeLeft / 60)
                    local osecs = openTimeLeft % 60
                    lRaid.Text = string.format("🏰 Stronghold: OPEN (%02d:%02d)", omins, osecs)
                else
                    local timeRemaining = 0
                    local hasValidSync = false
                    if _G.LastStrongholdTimer and _G.LastStrongholdTimerTick then
                        timeRemaining = _G.LastStrongholdTimer - (os.time() - _G.LastStrongholdTimerTick)
                        if timeRemaining > 0 then hasValidSync = true end
                    end
                    
                    if hasValidSync then
                        local mins = math.floor(timeRemaining / 60)
                        local secs = timeRemaining % 60
                        lRaid.Text = string.format("🏰 Stronghold: %02d:%02d", mins, secs)
                    else
                        if _G.FinalGateOpenTime and (os.time() - _G.FinalGateOpenTime >= 300) then
                            local timeSinceClosed = (os.time() - _G.FinalGateOpenTime) - 300
                            local predictedTime = 900 - (timeSinceClosed % 900)
                            local mins = math.floor(predictedTime / 60)
                            local secs = predictedTime % 60
                            lRaid.Text = string.format("🏰 Stronghold: ~%02d:%02d", mins, secs)
                        elseif _G.LastStrongholdTimer and timeRemaining <= 0 then
                            lRaid.Text = "🏰 Stronghold: RAIDING.."
                        else
                            lRaid.Text = "🏰 Stronghold: Wait..."
                        end
                    end
                end
            end
        end
    end
end)



