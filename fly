-- Custom Animation Engine to bypass RegisterKeyframeSequence blocks
CustomAnimator = {}
CustomAnimator.__index = CustomAnimator

function CustomAnimator.new(character)
    local self = setmetatable({}, CustomAnimator)
    self.Character = character
    self.Motors = {}
    for _, desc in ipairs(character:GetDescendants()) do
        if desc:IsA("Motor6D") and desc.Part1 then
            self.Motors[desc.Part1.Name] = desc
        end
    end
    self.ActiveTrack = nil
    self.StartTime = 0
    
    self.RenderConnection = game:GetService("RunService").Stepped:Connect(function()
        self:Update()
    end)
    return self
end

function CustomAnimator:Destroy()
    if self.RenderConnection then
        self.RenderConnection:Disconnect()
    end
end

function CustomAnimator:Play(parsedTrack)
    self.ActiveTrack = parsedTrack
    self.StartTime = tick()
end

function CustomAnimator:Stop()
    self.ActiveTrack = nil
end

function CustomAnimator:Update()
    if not self.ActiveTrack then return end
    
    local t = tick() - self.StartTime
    if t > self.ActiveTrack.Length then
        if self.ActiveTrack.Looped then
            self.StartTime = tick()
            t = 0
        else
            self.ActiveTrack = nil
            return
        end
    end
    
    local kf1, kf2 = self.ActiveTrack:GetKeyframesAt(t)
    local alpha = 0
    if kf2 and kf1 ~= kf2 and kf2.Time > kf1.Time then
        alpha = (t - kf1.Time) / (kf2.Time - kf1.Time)
    end
    
    local isR6 = (self.Character and self.Character:FindFirstChild("Torso") ~= nil)
    if isR6 then
        local rightArm = self.Motors["Right Arm"]
        local leftArm = self.Motors["Left Arm"]
        local rightLeg = self.Motors["Right Leg"]
        local leftLeg = self.Motors["Left Leg"]
        local tm = tick()
        local sine = math.sin(tm * 4)
        local slowSine = math.sin(tm * 1.5)
        
        if self.ActiveTrack.Name == "Fly" then
            if rightArm then rightArm.Transform = CFrame.Angles(math.rad(90 + sine * 5), 0, 0) end
            if leftArm then leftArm.Transform = CFrame.Angles(math.rad(90 - sine * 5), 0, 0) end
            if rightLeg then rightLeg.Transform = CFrame.Angles(math.rad(-20 + sine * 5), 0, 0) end
            if leftLeg then leftLeg.Transform = CFrame.Angles(math.rad(-20 - sine * 5), 0, 0) end
        else
            if rightArm then rightArm.Transform = CFrame.Angles(math.rad(20 + slowSine * 5), 0, 0) end
            if leftArm then leftArm.Transform = CFrame.Angles(math.rad(20 + slowSine * 5), 0, 0) end
            if rightLeg then rightLeg.Transform = CFrame.Angles(math.rad(-10 + slowSine * 3), 0, 0) end
            if leftLeg then leftLeg.Transform = CFrame.Angles(math.rad(-10 - slowSine * 3), 0, 0) end
        end
        return
    end
    
    for partName, motor in pairs(self.Motors) do
        local pose1 = kf1.Poses[partName]
        local pose2 = kf2 and kf2.Poses[partName] or pose1
        
        if pose1 then
            local targetCF = pose1
            if pose2 and pose1 ~= pose2 then
                targetCF = pose1:Lerp(pose2, alpha)
            end
            motor.Transform = targetCF
        end
    end
end

local function parseKeyframeSequence(ks)
    local track = {Length = 0, Keyframes = {}, Looped = true, Name = ks.Name}
    
    local function flattenPoses(pose, dict)
        if pose:IsA("Pose") then
            dict[pose.Name] = pose.CFrame
        end
        for _, child in ipairs(pose:GetChildren()) do
            flattenPoses(child, dict)
        end
    end
    
    local keyframes = {}
    for _, child in ipairs(ks:GetChildren()) do
        if child:IsA("Keyframe") then table.insert(keyframes, child) end
    end
    table.sort(keyframes, function(a,b) return a.Time < b.Time end)
    
    for _, kf in ipairs(keyframes) do
        local dict = {}
        for _, pose in ipairs(kf:GetChildren()) do
            flattenPoses(pose, dict)
        end
        table.insert(track.Keyframes, {Time = kf.Time, Poses = dict})
        if kf.Time > track.Length then track.Length = kf.Time end
    end
    
    function track:GetKeyframesAt(t)
        if #self.Keyframes == 1 then return self.Keyframes[1], nil end
        for i = 1, #self.Keyframes - 1 do
            if t >= self.Keyframes[i].Time and t <= self.Keyframes[i+1].Time then
                return self.Keyframes[i], self.Keyframes[i+1]
            end
        end
        return self.Keyframes[#self.Keyframes], nil
    end
    
    return track
end

