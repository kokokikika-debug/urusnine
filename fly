-- NO FOG
local function getAtmospheres()
    local t = {}
    for _, v in ipairs(_Lighting:GetChildren()) do
        if v:IsA("Atmosphere") then table.insert(t, v) end
    end
    return t
end

local function cacheAtmosphere(a)
    if DEFAULT_LIGHTING.Atmosphere[a] then return end
    DEFAULT_LIGHTING.Atmosphere[a] = {
        Density = a.Density,
        Haze = a.Haze,
    }
end

mapTilesContainers = {}
mapIconsContainers = {}
mapContainersCached = false
cachedBoundaries = {}

local function cacheMapContainers()
    if mapContainersCached then return end
    pcall(function()
        local PlayerGui = _LocalPlayer:WaitForChild("PlayerGui")
        for _, gui in ipairs(PlayerGui:GetDescendants()) do
            if gui.Name == "Tiles" and gui.Parent and (gui.Parent.Name == "Map" or gui.Parent.Name == "CaveMap") then
                table.insert(mapTilesContainers, gui)
            end
            if gui.Name == "Icons" and gui.Parent and (gui.Parent.Name == "Map" or gui.Parent.Name == "CaveMap") then
                table.insert(mapIconsContainers, gui)
            end
        end
        if #mapTilesContainers > 0 then mapContainersCached = true end
    end)
end

local function applyNoFog()
    _Lighting.FogStart = 1e7
    _Lighting.FogEnd   = 1e7 + 1000
    for _, a in ipairs(getAtmospheres()) do
        cacheAtmosphere(a)
        a.Density = 0
        a.Haze = 0
    end
    
    -- Clear 2D Map Fog (Poster Map) & Reveal Icons (CACHED - NO LAG)
    cacheMapContainers()
    pcall(function()
        for _, tiles in ipairs(mapTilesContainers) do
            tiles.Visible = false
        end
        for _, icons in ipairs(mapIconsContainers) do
            for _, icon in ipairs(icons:GetChildren()) do
                if icon:IsA("ImageLabel") then icon.Visible = true end
            end
        end
    end)
end

local function restoreFog()
    _Lighting.FogStart = DEFAULT_LIGHTING.FogStart
    _Lighting.FogEnd   = DEFAULT_LIGHTING.FogEnd
    for a, d in pairs(DEFAULT_LIGHTING.Atmosphere) do
        if a and a.Parent then
            a.Density = d.Density
            a.Haze = d.Haze
        end
    end
    
    for part, origTrans in pairs(cachedBoundaries) do
        if part and part.Parent then
            part.Transparency = origTrans
        end
    end
    cachedBoundaries = {}
    
    -- Restore 2D Map Fog
    pcall(function()
        for _, tiles in ipairs(mapTilesContainers) do
            tiles.Visible = true
        end
    end)
end

_Lighting.ChildAdded:Connect(function(child)
    if NoFogEnabled and child:IsA("Atmosphere") then
        task.delay(0.1, applyNoFog)
    end
end)

_Lighting:GetPropertyChangedSignal("FogEnd"):Connect(function()
    if NoFogEnabled then task.delay(0.1, applyNoFog) end
end)

local function startTick()
    if tickConn then return end
    tickConn = task.spawn(function()
        while NoFogEnabled do
            applyNoFog()
            task.wait(1.2)
        end
    end)
end

local function stopTick()
    if tickConn then
        task.cancel(tickConn)
        tickConn = nil
    end
end

