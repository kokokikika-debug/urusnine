local function setupFlyAnimations()
    if ParsedFlyAnim and ParsedHoverAnim then return true end
    
    local animFolder = buildFlyAnimations()
    local flyKS = animFolder:FindFirstChild("Fly")
    local hoverKS = animFolder:FindFirstChild("Hover")
    
    if flyKS and hoverKS then
        ParsedFlyAnim = parseKeyframeSequence(flyKS)
        ParsedHoverAnim = parseKeyframeSequence(hoverKS)
        return true
    end
    return false
end


R6Tracks = {}
currentR6Track = nil
isR6Avatar = false

local function startFlying()
    if flying then return end
    flying = true
    local character = _LocalPlayer.Character
    if not character then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChild("Humanoid")
    if not hrp or not humanoid then return end

    isR6Avatar = (character:FindFirstChild("Torso") ~= nil)
    local hasAnims = false
    
    if isR6Avatar then
        local function loadAnim(id)
            local a = Instance.new("Animation")
            a.AnimationId = "rbxassetid://" .. tostring(id)
            local track = humanoid.Animator:LoadAnimation(a)
            track.Looped = true
            return track
        end
        pcall(function()
            R6Tracks.Hover = loadAnim(97171309)
            R6Tracks.SlowFly = loadAnim(97169019)
            R6Tracks.FastFly = loadAnim(282574440)
        end)
        if character:FindFirstChild("Animate") then character.Animate.Disabled = true end
        for _, track in ipairs(humanoid.Animator:GetPlayingAnimationTracks()) do
            track:Stop()
        end
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Running, false)
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Climbing, false)
        humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Freefall, false)
        humanoid:ChangeState(Enum.HumanoidStateType.Physics)
        humanoid.PlatformStand = true
        
        if hrp:FindFirstChild("Running") then hrp.Running.Volume = 0 end
        
        currentR6Track = nil
        
        if not FlySound then
            FlySound = Instance.new("Sound")
            FlySound.SoundId = "rbxassetid://3308152153"
            FlySound.Volume = 0.2
            FlySound.Looped = true
            FlySound.Parent = hrp
        end
        FlySound:Play()
    else
        -- Setup Authentic Animations
        hasAnims = setupFlyAnimations()
        if hasAnims then
            if character:FindFirstChild("Animate") then character.Animate.Disabled = true end
            for _, track in ipairs(humanoid.Animator:GetPlayingAnimationTracks()) do
                track:Stop()
            end
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Running, false)
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Climbing, false)
            humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Freefall, false)
            humanoid:ChangeState(Enum.HumanoidStateType.Physics)
            humanoid.PlatformStand = true
            
            if hrp:FindFirstChild("Running") then hrp.Running.Volume = 0 end
            
            if not FlySound then
                FlySound = Instance.new("Sound")
                FlySound.SoundId = "rbxassetid://3308152153"
                FlySound.Volume = 0.2
                FlySound.Looped = true
                FlySound.Parent = hrp
            end
            FlySound:Play()
            if not MyCustomAnimator then
                MyCustomAnimator = CustomAnimator.new(character)
            end
            MyCustomAnimator:Play(ParsedHoverAnim)
        end
    end

    local gyro = Instance.new("BodyGyro")
    gyro.Name = "FlyGyro"
    gyro.P = 9e4
    gyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    gyro.CFrame = workspace.CurrentCamera.CFrame
    gyro.Parent = hrp

    local velocity = Instance.new("BodyVelocity")
    velocity.Name = "FlyVelocity"
    velocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    velocity.Parent = hrp

    flyConnection = _RunService.RenderStepped:Connect(function()
        if not flying then return end

        local character = _LocalPlayer.Character
        if not character then return end

        local hrp = character:FindFirstChild("HumanoidRootPart")
        local humanoid = character:FindFirstChild("Humanoid")
        local camera = workspace.CurrentCamera

        if not hrp or not humanoid or not camera then return end

        -- Biar sistem gerak & rotasi bawaan Roblox ga rebutan sama BodyVelocity/BodyGyro kita
        humanoid.AutoRotate = false
        if humanoid:GetState() ~= Enum.HumanoidStateType.Physics then
            humanoid:ChangeState(Enum.HumanoidStateType.Physics)
        end

        local camCF = camera.CFrame
        local speed = 250

        if WalkSpeedEnabled and TargetWalkSpeed ~= 16 then
            speed = TargetWalkSpeed
        end

        --==================================================
        -- INPUT GERAK (PC / Mobile / Gamepad - satu jalur lewat MoveDirection)
        --==================================================

        local lookXZ = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z)
        local rightXZ = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z)

        local flatLook = lookXZ.Magnitude > 0.001 and lookXZ.Unit or Vector3.new(0, 0, -1)
        local flatRight = rightXZ.Magnitude > 0.001 and rightXZ.Unit or Vector3.new(1, 0, 0)

        -- MoveDirection sudah otomatis terisi dari WASD, joystick mobile, maupun gamepad,
        -- jadi ini satu-satunya sumber input gerak horizontal yang kita baca
        local moveDir = humanoid.MoveDirection

        -- Uraikan jadi "seberapa maju" & "seberapa nyamping" relatif kamera (versi datar dulu)
        local forwardAmount = moveDir:Dot(flatLook)
        local strafeAmount = moveDir:Dot(flatRight)

        -- Baru disusun ulang pakai LookVector/RightVector kamera yang PUNYA kemiringan,
        -- biar nunduk/dongak kamera beneran bikin badan turun/naik kayak terbang asli
        local moveVec = (camCF.LookVector * forwardAmount) + (camCF.RightVector * strafeAmount)

        --==================================================
        -- NAIK / TURUN
        --==================================================

        if _UserInputService:IsKeyDown(Enum.KeyCode.Space) then
            moveVec = moveVec + Vector3.new(0, 1, 0)
        end

        if _UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
            moveVec = moveVec - Vector3.new(0, 1, 0)
        end

        --==================================================
        -- APPLY MOVEMENT
        --==================================================

        if moveVec.Magnitude > 0.01 then
            velocity.Velocity = moveVec.Unit * speed
        else
            velocity.Velocity = Vector3.new(
                0,
                math.sin(time() * 3) * 1.5,
                0
            )
        end

        --==================================================
        -- FOLLOW CAMERA
        --==================================================

        gyro.CFrame = camCF

        if hrp:FindFirstChild("Running") then
            hrp.Running.Volume = 0
        end

        --==================================================
        -- ANIMATION
        --==================================================

        if isR6Avatar then

            -- Default: TIDAK ADA ANIMASI saat diam
            local desiredTrack = nil

            -- Saat bergerak: selalu gunakan pose Super Hero
            if moveVec.Magnitude > 0.05 then
                desiredTrack = R6Tracks.FastFly
            end

            -- Ganti track hanya jika memang berubah
            if currentR6Track ~= desiredTrack then

                if currentR6Track then
                    currentR6Track:Stop()
                end

                currentR6Track = desiredTrack

                if currentR6Track then
                    currentR6Track:Play()
                end
            end

        elseif hasAnims and MyCustomAnimator then

            if moveVec.Magnitude > 0.05 then

                if MyCustomAnimator.ActiveTrack ~= ParsedFlyAnim then
                    MyCustomAnimator:Play(ParsedFlyAnim)
                end

            else

                if MyCustomAnimator.ActiveTrack ~= ParsedHoverAnim then
                    MyCustomAnimator:Play(ParsedHoverAnim)
                end

            end
        end
    end)
    
    armConnection = _RunService.Stepped:Connect(function()
        if not flying or not isR6Avatar then
            return
        end

        local character = _LocalPlayer.Character
        if not character then
            return
        end

        local torso = character:FindFirstChild("Torso")
        if not torso then
            return
        end

        local rs = torso:FindFirstChild("Right Shoulder")
        local ls = torso:FindFirstChild("Left Shoulder")
        local rh = torso:FindFirstChild("Right Hip")
        local lh = torso:FindFirstChild("Left Hip")
        local neck = torso:FindFirstChild("Neck")

        -- =====================================================
        -- HOVER / IDLE
        -- =====================================================
        if currentR6Track == nil then

            -- Tangan static
            if rs then
                rs.Transform = CFrame.Angles(math.rad(15), 0, 0)
            end

            if ls then
                ls.Transform = CFrame.Angles(math.rad(15), 0, 0)
            end

            -- Kaki static / lurus
            if rh then
                rh.Transform = CFrame.new()
            end

            if lh then
                lh.Transform = CFrame.new()
            end

            -- Kepala static
            if neck then
                neck.Transform = CFrame.new()
            end
        end
    end)
end

local function stopFlying()
    flying = false
    if flyConnection then
        flyConnection:Disconnect()
        flyConnection = nil
    end
    if armConnection then
        armConnection:Disconnect()
        armConnection = nil
    end
    
    if currentR6Track then currentR6Track:Stop() currentR6Track = nil end
    if FlyAnimTrack then FlyAnimTrack:Stop() end
    if HoverAnimTrack then HoverAnimTrack:Stop() end
    if FlySound then FlySound:Stop() end

    -- Destroy langsung instance yang dipakai pas terbang (bukan nyari lewat class),
    -- biar pasti kena walaupun parent-nya bukan di HumanoidRootPart, dan ga ikut
    -- ngehapus BodyVelocity/BodyGyro punya sistem lain kalau kebetulan ada di part yang sama
    if velocity then
        velocity:Destroy()
        velocity = nil
    end

    if gyro then
        gyro:Destroy()
        gyro = nil
    end
    
    local character = _LocalPlayer.Character
    if character and character:FindFirstChild("HumanoidRootPart") then
        local hrp = character.HumanoidRootPart
        local humanoid = character:FindFirstChild("Humanoid")

        -- Jaring pengaman kalau-kalau masih ada sisa BodyGyro/BodyVelocity nyangkut
        for _, v in ipairs(hrp:GetChildren()) do
            if v:IsA("BodyGyro") or v:IsA("BodyVelocity") then
                v:Destroy()
            end
        end
        
        if humanoid then
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Running, true)
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Climbing, true)
            humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)
            
