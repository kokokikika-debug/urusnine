local function isItemInIceTemple(item)
    if not item then return false end
    local map = workspace:FindFirstChild("Map")
    if not map then return false end
    local landmarks = map:FindFirstChild("Landmarks")
    if not landmarks then return false end
    local iceTemple = landmarks:FindFirstChild("Ice Temple")
    if not iceTemple then return false end
