                            end
                        end
                        if isEnemyName then
                            stackHeight = (stackHeight + 0.5) % 25
                            local angle = brought * math.rad(35)
                            local dropPos = destPos + Vector3.new(math.cos(angle) * 3, stackHeight, math.sin(angle) * 3)
