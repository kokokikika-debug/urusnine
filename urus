-- KIXHUB payload loader
-- Keep this bootstrap small; payload source is served by the private distribution Worker.

local HttpService = game:GetService("HttpService")
local REQUEST_ATTEMPTS = 3

local function getRequestFunctions()
    local functions = {}
    local seen = {}
    local function add(candidate)
        if type(candidate) == "function" and not seen[candidate] then
            seen[candidate] = true
            table.insert(functions, candidate)
        end
    end
    add(request)
    add(http_request)
    if type(syn) == "table" then add(syn.request) end
    if type(http) == "table" then add(http.request) end
    if type(fluxus) == "table" then add(fluxus.request) end
    return functions
end

local requestFunctions = getRequestFunctions()
local env = getgenv and getgenv() or _G
local now = os.clock()
local executionState
if type(env) ~= "table" then return end
executionState = env.KixHubLoaderExecution
if type(executionState) ~= "table" then
    executionState = {}
    env.KixHubLoaderExecution = executionState
end

local activeSince = tonumber(executionState.StartedAt) or tonumber(env.KixHubLoaderLastRequest)
if executionState.InFlight == true and activeSince and now - activeSince < 90 then return end
if executionState.CompletedAt and now - (tonumber(executionState.CompletedAt) or 0) < 3 then return end
-- Keep old loader copies from overlapping with this version during rollout.
if tonumber(env.KixHubLoaderLastRequest) and now - env.KixHubLoaderLastRequest < 3 then return end

executionState.InFlight = true
executionState.StartedAt = now
env.KixHubLoaderLastRequest = now

local baseUrl = "https://kixhub-distribution.lirikkuviral.workers.dev"
local playerId = ""
pcall(function()
    playerId = tostring(game:GetService("Players").LocalPlayer.UserId)
end)

local function safeBodySnippet(value)
    local snippet = tostring(value or "")
    snippet = string.gsub(snippet, "[%c]", " ")
    if #snippet > 180 then snippet = string.sub(snippet, 1, 180) .. "..." end
    return snippet
end

local function post(path, body)
    local encoded = HttpService:JSONEncode(body)
    local options = {
        Url = baseUrl .. path,
        Method = "POST",
        Headers = { ["Content-Type"] = "application/json", Accept = "text/plain, application/json" },
        Body = encoded,
        body = encoded,
    }

    local called, response, secondary
    local lastError = "HTTP request failed"

    for attempt = 1, REQUEST_ATTEMPTS do
        response = nil
        secondary = nil

        for _, requestFunction in ipairs(requestFunctions) do
            called, response, secondary = pcall(requestFunction, options)
            local responseStatus = type(response) == "table"
                and tonumber(response.StatusCode or response.Status or response.status_code or response.status)
                or (type(response) == "string" and 200 or 0)

            if called and response ~= nil and responseStatus and responseStatus > 0 then
                break
            end

            lastError = tostring(response or secondary or lastError)
            response = nil
        end

        if response ~= nil then break end
        if attempt < REQUEST_ATTEMPTS then
            task.wait(attempt)
        end
    end
    if not called or response == nil then return 0, nil, lastError end

    local status = 0
    local raw = ""
    local contentType = ""
    if type(response) == "table" then
        status = tonumber(response.StatusCode or response.Status or response.status_code or response.status or secondary) or 0
        raw = response.Body or response.body or response.ResponseBody or response.responseBody or ""
        local headers = response.Headers or response.headers
        if type(headers) == "table" then
            contentType = tostring(headers["Content-Type"] or headers["content-type"] or "")
        end
    elseif type(response) == "string" then
        raw = response
        status = tonumber(secondary) or 200
    end
    if type(raw) ~= "string" then raw = tostring(raw or "") end
    if status == 0 and raw ~= "" then
        local contentTypeLower = string.lower(contentType)
        if string.find(contentTypeLower, "text/plain", 1, true)
            or string.find(contentTypeLower, "application/json", 1, true) then
            status = 200
        end
    end

    local decoded, result = pcall(HttpService.JSONDecode, HttpService, raw)
    if decoded and type(result) == "table" then
        return status, result, nil, raw
    end

    -- The Worker can return source directly for executors that handle text/plain more reliably.
    if status >= 200 and status < 300 and raw ~= "" then
        return status, { authorized = true, source = raw }, nil, raw
    end
    return status, nil, "HTTP " .. tostring(status) .. " returned non-JSON: " .. safeBodySnippet(raw), raw
end

local function runKixHubLoader()
if #requestFunctions == 0 then
    warn("[KixHub] This executor does not expose an HTTP request function.")
    return false
end

local payloadStatus, payloadBody, payloadError = post("/v1/temporary/load/99nights-usa", {
    client_version = "kixhub-usa-loader/1.2",
    response_format = "source",
    player_id = playerId,
})

if payloadStatus == 429 then
    warn("[KixHub] Too many loader requests. Wait before running it again.")
    return
end
if payloadStatus < 200 or payloadStatus >= 300 or not payloadBody
    or payloadBody.authorized == false or type(payloadBody.source) ~= "string" or payloadBody.source == "" then
    local detail = (payloadBody and payloadBody.error) or payloadError or ("HTTP " .. tostring(payloadStatus))
    warn("[KixHub] Payload request failed: " .. safeBodySnippet(detail))
    return
end

if type(loadstring) ~= "function" then
    warn("[KixHub] loadstring is unavailable in this executor.")
    return
end

-- Delta mobile may not accept the optional chunk-name argument consistently.
-- Compile the delivered source with the one-argument form and preserve any
-- compiler diagnostic returned by the executor.
local compiled, chunk, compileError = pcall(loadstring, payloadBody.source)
if not compiled or type(chunk) ~= "function" then
    local detail = compileError or chunk
    if detail == nil then
        detail = "Executor loadstring returned no function or error detail."
    end
    warn("[KixHub] Payload compile failed: " .. tostring(detail))
    return
end

local ran, runtimeError = pcall(chunk)
if not ran then
    warn("[KixHub] Payload runtime failed: " .. tostring(runtimeError))
    return false
end
return true
end

local ranLoader, payloadLoaded = pcall(runKixHubLoader)
executionState.InFlight = false
executionState.CompletedAt = os.clock()
executionState.Loaded = ranLoader and payloadLoaded == true
if not ranLoader then
    warn("[KixHub] Loader failed: " .. tostring(payloadLoaded))
end
