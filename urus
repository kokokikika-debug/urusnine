local HttpService = game:GetService("HttpService")
local requestFunction = type(request) == "function" and request
    or type(http_request) == "function" and http_request
    or type(syn) == "table" and type(syn.request) == "function" and syn.request

if not requestFunction then
    warn("[KixHub Urus] Executor HTTP request is unavailable.")
    return
end

local baseUrl = "https://kixhub-distribution.lirikkuviral.workers.dev"

local function post(path, body)
    local encoded = HttpService:JSONEncode(body)
    local response = requestFunction({
        Url = baseUrl .. path,
        Method = "POST",
        Headers = { ["Content-Type"] = "application/json" },
        Body = encoded,
        body = encoded,
    })
    local status = tonumber(response and (response.StatusCode or response.Status or response.status_code)) or 0
    local raw = response and (response.Body or response.body) or ""
    local decoded, result = pcall(HttpService.JSONDecode, HttpService, raw)
    if not decoded or type(result) ~= "table" then
        return status, nil, "The distribution service returned invalid JSON."
    end
    return status, result, nil
end

local payloadStatus, payloadBody, payloadError = post("/v1/temporary/load/99nights-urus", {
    client_version = "kixhub-urus-loader/1.1",
})

if payloadStatus ~= 200 or not payloadBody or payloadBody.authorized ~= true or type(payloadBody.source) ~= "string" then
    warn("[KixHub Urus] Payload request failed: " .. tostring((payloadBody and payloadBody.error) or payloadError or payloadStatus))
    return
end

if type(loadstring) ~= "function" then
    warn("[KixHub Urus] loadstring is unavailable in this executor.")
    return
end

local compiled, chunk = pcall(loadstring, payloadBody.source, "=KixHub/99nights-urus")
if not compiled or type(chunk) ~= "function" then
    warn("[KixHub Urus] Payload compile failed: " .. tostring(chunk))
    return
end

local ran, runtimeError = pcall(chunk)
if not ran then
    warn("[KixHub Urus] Payload runtime failed: " .. tostring(runtimeError))
end
